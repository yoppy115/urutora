<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Keep vulnerability findings fatal, but do not fail solely because the audit service is unreachable. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.2.3</Version>
    <AssemblyVersion>0.2.3.0</AssemblyVersion>
    <FileVersion>0.2.3.0</FileVersion>
    <RepositoryCommit Condition="'$(RepositoryCommit)' == ''">unknown</RepositoryCommit>
    <RepositoryTreeState Condition="'$(RepositoryTreeState)' == ''">unknown</RepositoryTreeState>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>$(Version)+$(RepositoryCommit).$(RepositoryTreeState)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="RepositoryCommit" Value="$(RepositoryCommit)" />
    <AssemblyMetadata Include="RepositoryTreeState" Value="$(RepositoryTreeState)" />
  </ItemGroup>
</Project>
